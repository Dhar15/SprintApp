<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯  GK OF THE DAY"
        android:textSize="8sp"
        android:textColor="#AA8844"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/gk_widget_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="POSITIONS"
        android:textSize="9sp"
        android:textColor="#FFB547"
        android:fontFamily="sans-serif-medium" />

    <View
        android:layout_width="24dp"
        android:layout_height="2dp"
        android:layout_marginTop="5dp"
        android:background="#FFB547" />

    <TextView
        android:id="@+id/gk_widget_fact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Open the app to load today's GK fact"
        android:textSize="11sp"
        android:textColor="#CCCCDD"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="sans-serif" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap to open Sprint →"
        android:textSize="9sp"
        android:textColor="#3A3A5A"
        android:fontFamily="sans-serif" />

</LinearLayout>