<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D0D1A" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main background -->
    <item
        android:bottom="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#13131F" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2A2A42" />
        </shape>
    </item>
</layer-list>